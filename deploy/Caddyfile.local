# Local stack (docker-compose.local.yml): plain HTTP on :80 inside the container,
# published as http://localhost:8080. Same routing as production (deploy/Caddyfile).
:80 {
	@backend path /api/* /health /docs /openapi.json /redoc

	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
